[Unit]
Description=Home Climate logging service
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=piadmin
WorkingDirectory=/home/piadmin/home-climate-v2/pi
ExecStart=/home/piadmin/home-climate-v2/pi/venv/bin/python main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
